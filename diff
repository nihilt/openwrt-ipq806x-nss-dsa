 ## Use "make defconfig" to expand this to a full .config
## Target
CONFIG_TARGET_ipq806x_generic_DEVICE_netgear_r7800=y
CONFIG_TARGET_ipq806x_generic=y
CONFIG_TARGET_ipq806x=y
CONFIG_EXPERIMENTAL=y
# Rust in the kernel fails to link on arm32 (4-byte vs 2-byte wchar_t)
CONFIG_DEVEL=y
CONFIG_RUST_TOOLCHAINOPTS=y
# CONFIG_KERNEL_RUST is not set
# CONFIG_BUILD_BINDGEN is not set
# CONFIG_USE_CBINDGEN is not set
# CONFIG_USE_CORROSION is not set

CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe"
CONFIG_EXTRA_OPTIMIZATION="-fno-caller-saves -fno-plt -fno-unwind-tables -fno-asynchronous-unwind-tables"
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_GCC_USE_GRAPHITE=y

## Use ath10k instead ath10k-ct
CONFIG_PACKAGE_ath10k-firmware-qca9984=y
# CONFIG_PACKAGE_ath10k-firmware-qca9984-ct is not set
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_ATH10K_LEDS=y
CONFIG_ATH10K_THERMAL=y
# CONFIG_PACKAGE_kmod-ath10k-ct is not set

## Use Openssl
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_OPENSSL_WITH_CHACHA_POLY1305=y

#CONFIG_FEED_sqm_scripts_nss=n  
